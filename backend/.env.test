# Test environment. Integration tests run against a throwaway database so they
# can truncate freely without touching dev data. Create it once with:
#   docker compose exec -T postgres createdb -U keepclone keepclone_test
# (or `pnpm db:up` then run the createdb line). No secrets here — committed on
# purpose so CI uses the same settings.
NODE_ENV=test
DATABASE_URL=postgres://keepclone:keepclone@localhost:5432/keepclone_test
LOG_LEVEL=silent
