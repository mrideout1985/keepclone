# Copy to .env and adjust. Used by docker-compose and the backend.

# --- Postgres (docker-compose) ---
POSTGRES_USER=keepclone
POSTGRES_PASSWORD=keepclone
POSTGRES_DB=keepclone
POSTGRES_PORT=5432

# --- Backend ---
NODE_ENV=development
PORT=4000
# Connection string the backend uses (matches the values above)
DATABASE_URL=postgres://keepclone:keepclone@localhost:5432/keepclone
# Comma-separated list of allowed CORS origins
CORS_ORIGIN=http://localhost:3000
LOG_LEVEL=info

# --- Auth / sessions ---
# How long a session (and its cookie) lasts, in days
SESSION_TTL_DAYS=30
# Send the session cookie only over HTTPS. Leave unset to default: on in
# production, off in development. Set to "true"/"false" to force it.
# COOKIE_SECURE=false
# Optional cookie domain (leave unset for host-only cookies in dev)
# COOKIE_DOMAIN=
